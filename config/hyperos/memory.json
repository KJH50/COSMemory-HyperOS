{
  "project": { "name": "COSMemory (HyperOS 推荐配置)", "author": "上游：是你吗薰儿 · 适配：KJH50" },
  "keepAlive": { "adj": 200, "enforce": true },
  "reclaim": { "aggressive": false, "depth": "cached", "psiThreshold": 5, "memFloorMB": 1024, "cooldownSec": 60, "maxKillPerRound": 5 },
  "freeze": { "enabled": true },
  "guard": { "mode": "observe", "block_rules": "o-stop,frozen,cached,empty,cpu" },
  "tuning": { "enabled": false },
  "log": { "path": "/sdcard/Android/COSMemory/Run.log", "level": "info" },
  "panel": { "port": 8085 }
}
